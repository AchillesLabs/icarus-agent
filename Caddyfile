{
    admin off
}

:80 {
    # Reverse proxy all API requests to the FastAPI backend service
    reverse_proxy api:8000 {
        # Disable response buffering for Server-Sent Events (SSE) streaming parity
        flush_interval -1
    }

    # Standard security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer-when-downgrade
        -Server
    }

    # Format stdout access logs
    log {
        output stdout
        format console
    }
}
